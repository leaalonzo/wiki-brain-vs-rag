OPENAI_API_KEY=sk-...

# Semantic Scholar API key (optional — raises rate limit from ~1 req/s to 10 req/s)
# Get one free at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Model config (optional overrides)
COMPILE_MODEL=gpt-4o
QA_MODEL=gpt-4o
LINT_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small

# ChromaDB config (optional)
CHROMA_PERSIST_DIR=rag/chroma_db
CHROMA_COLLECTION=wiki_brain
